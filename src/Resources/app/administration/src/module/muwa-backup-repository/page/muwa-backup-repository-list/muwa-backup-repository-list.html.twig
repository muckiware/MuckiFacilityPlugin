{% block muwa_backup_repository_list %}
    <sw-page class="muwa-backup-repository-list">
        {% block muwa_backup_repository_list_smart_bar_actions %}
            <template #smart-bar-actions>
                <sw-button
                    v-if="tab === 'databaseConnectionList'"
                    variant="primary"
                    position-identifier="muwa-database-connection-create-button"
                    :disabled="!acl.can('muwa_backup_repository.creator')"
                    :routerLink="{ name: 'muwa.backup.repository.databaseConnectionCreate' }"
                >
                    {{ $t('muwa-backup-repository.databaseConnection.createButton') }}
                </sw-button>
                <sw-button
                    v-else-if="tab === 's3ConnectionList'"
                    variant="primary"
                    position-identifier="muwa-s3-connection-create-button"
                    :disabled="!acl.can('muwa_backup_repository.creator')"
                    :routerLink="{ name: 'muwa.backup.repository.s3ConnectionCreate' }"
                >
                    {{ $t('muwa-backup-repository.s3Connection.createButton') }}
                </sw-button>
                <sw-button
                    v-else
                    variant="primary"
                    position-identifier="muwa-backup-repository-create-button"
                    :disabled="!acl.can('muwa_backup_repository.creator')"
                    @click="showAddModal = true"
                >
                    {{ $tc('muwa-backup-repository.list.header.createButtonLabel') }}
                </sw-button>
                <muwa-backup-repository-add-modal
                    v-if="showAddModal"
                    @modal-close="showAddModal = false"
                />
            </template>
        {% endblock %}

        <template #content>
            {% block muwa_backup_repository_list_content %}
                {% block muwa_search_structure_content_tabs %}
                    <sw-tabs default-item="repositoryList" class="muwa-backup-repository-content-tabs" position-identifier="muwa-backup-repository-content-tabs">
                        <template #default="{ active }">
                            <sw-tabs-item
                                key="repositoryList"
                                :active-tab="active"
                                :route="{ name: 'muwa.backup.repository.index', params: { tab: 'repositoryList' } }"
                                @click="getList()"
                            >
                                {{ $tc('muwa-backup-repository.tabs.repositoryList') }}
                            </sw-tabs-item>
                            <sw-tabs-item
                                key="databaseConnectionList"
                                :active-tab="active"
                                :route="{ name: 'muwa.backup.repository.index', params: { tab: 'databaseConnectionList' } }"
                            >
                                {{ $t('muwa-backup-repository.databaseConnection.tabLabel') }}
                            </sw-tabs-item>
                            <sw-tabs-item
                                key="s3ConnectionList"
                                :active-tab="active"
                                :route="{ name: 'muwa.backup.repository.index', params: { tab: 's3ConnectionList' } }"
                            >
                                {{ $t('muwa-backup-repository.s3Connection.tabLabel') }}
                            </sw-tabs-item>
                        </template>
                    </sw-tabs>
                {% endblock %}

                <muwa-database-connection-list
                    v-if="tab === 'databaseConnectionList'"
                />

                <muwa-s3-connection-list
                    v-if="tab === 's3ConnectionList'"
                />

                <sw-entity-listing
                        v-if="backupRepository && tab === 'repositoryList'"
                        :isLoading="isLoading"
                        :items="backupRepository"
                        :repository="repository"
                        :columns="columns"
                        :showActions="true"
                        :showSelection="true"
                        :showSettings="true"
                        identifier="muwa-backup-repository-list"
                >
                    <template #column-name="{item}">
                        <router-link :to="{ name: 'muwa.backup.repository.detail', params: { id: item.id } }">
                            <div v-if="item.name" :title="item.name">
                                {{ item.name }}
                            </div>
                            <div v-else :title="item.name">
                                <sw-icon class="muwa.search.structure-list-times" name="regular-times" small></sw-icon>
                            </div>
                        </router-link>
                    </template>

                    <!-- eslint-disable-next-line sw-deprecation-rules/no-twigjs-blocks -->
                    {% block muwa_backup_repository_list_grid_columns_active %}
                        <template #column-active="{ item, isInlineEdit }">
                            <!-- eslint-disable-next-line sw-deprecation-rules/no-twigjs-blocks -->
                            {% block muwa_backup_repository_list_grid_columns_active_inline_edit %}
                                <template v-if="isInlineEdit">
                                    <sw-checkbox-field v-model:value="item.active"/>
                                </template>
                            {% endblock %}

                            <!-- eslint-disable-next-line sw-deprecation-rules/no-twigjs-blocks -->
                            {% block muwa_backup_repository_list_grid_columns_active_content %}
                                <template v-else>
                                    <sw-icon
                                            v-if="item.active"
                                            name="regular-checkmark-xs"
                                            small
                                            class="is--active"
                                    />
                                    <sw-icon
                                            v-else
                                            name="regular-times-s"
                                            small
                                            class="is--inactive"
                                    />
                                </template>
                            {% endblock %}
                        </template>
                    {% endblock %}
                    <template #column-createdAt="{ item }">
                        {{ dateFilter(item.createdAt) }}
                    </template>
                    <template #column-updatedAt="{ item }">
                        {{ dateFilter(item.updatedAt) }}
                    </template>

                    <!-- eslint-disable-next-line sw-deprecation-rules/no-twigjs-blocks -->
                    {% block muwa_backup_repository_list_grid_columns_check_status %}
                        <template #column-checkStatus="{ item }">
                            <sw-icon
                                    v-if="isCheckStatusOk(item)"
                                    name="regular-checkmark-xs"
                                    small
                                    class="is--active"
                            />
                            <sw-icon
                                    v-else
                                    name="regular-times-s"
                                    small
                                    class="is--inactive"
                            />
                        </template>
                    {% endblock %}
                    {% block muwa_backup_repository_list_grid_columns_last_backup_at %}
                        <template #column-lastBackupAt="{ item }">
                            {{ getLatestStats(item)?.createdAt ? dateFilter(getLatestStats(item).createdAt, { hour: '2-digit', minute: '2-digit' }) : $t('muwa-backup-repository.detail.statsNoValue') }}
                        </template>
                    {% endblock %}
                    {% block muwa_backup_repository_list_grid_columns_next_scheduled_backup %}
                        <template #column-nextScheduledBackup="{ item }">
                            {{ formatNextScheduledBackup(item) }}
                        </template>
                    {% endblock %}
                    {% block muwa_backup_repository_list_grid_columns_actions %}
                        <template #delete-action="{ item }">
                            <sw-context-menu-item @click="onDelete(item.id)" variant="danger">
                                {{ $tc('global.default.delete') }}
                            </sw-context-menu-item>
                        </template>
                    {% endblock %}

                    {% block muwa_backup_repository_list_delete_modal %}
                        <template #action-modals="{ item }">
                            <sw-modal
                                v-if="showDeleteModal === item.id"
                                :title="$t('global.default.warning')"
                                variant="small"
                                @modal-close="onCloseDeleteModal"
                            >
                                {% block muwa_backup_repository_list_delete_modal_confirm_delete_text %}
                                    <p class="muwa-backup-repository-list__confirm-delete-text">
                                        {{ $t('muwa-backup-repository.list.textDeleteRepositoryConfirm') }}
                                    </p>
                                {% endblock %}

                                {% block muwa_backup_repository_list_delete_modal_footer %}
                                    <template #modal-footer>
                                        <sw-button size="small" @click="onCloseDeleteModal">
                                            {{ $t('global.default.cancel') }}
                                        </sw-button>
                                        <sw-button variant="danger" size="small" @click="onConfirmDelete(item)">
                                            {{ $t('global.default.delete') }}
                                        </sw-button>
                                    </template>
                                {% endblock %}
                            </sw-modal>
                        </template>
                    {% endblock %}
                </sw-entity-listing>
            {% endblock %}
        </template>
    </sw-page>

{% endblock %}