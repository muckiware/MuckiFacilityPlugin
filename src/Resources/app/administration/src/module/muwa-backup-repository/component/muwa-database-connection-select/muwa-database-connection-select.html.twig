{% block muwa_database_connection_select %}
    <div class="muwa-database-connection-select">
        {# From 6.7 on sw-select-field renders mt-select, which binds via modelValue. #}
        <sw-select-field
            v-if="isV6700"
            v-model="selectedValue"
            :options="connectionOptions"
            :disabled="disabled"
            :label="$t('muwa-backup-repository.databaseConnection.selectLabel')"
            :help-text="$t('muwa-backup-repository.databaseConnection.selectHelpText')"
        />
        <sw-select-field
            v-if="isV6600 && !isV6700"
            v-model:value="selectedValue"
            :options="connectionOptions"
            :disabled="disabled"
            :label="$t('muwa-backup-repository.databaseConnection.selectLabel')"
            :help-text="$t('muwa-backup-repository.databaseConnection.selectHelpText')"
        />
    </div>
{% endblock %}
